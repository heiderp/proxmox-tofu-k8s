#!/usr/sbin/nft -f
# Gestionado por Ansible (rol engram_base). Política: denegar todo lo entrante.
flush ruleset

table inet filter {
	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		ip protocol icmp accept

		# Desde la LAN: administración (Ansible, debian) y Engram Cloud para los
		# clientes que viven en casa (el PC), sin pasar por la overlay.
		ip saddr {{ lan_cidr }} tcp dport { 22, 443 } accept

		# Por la overlay: SSH (solo engram-grant, lo filtra sshd) y Engram Cloud.
		iifname "zt*" tcp dport { 22, 443 } accept

		# Transporte de ZeroTier entre peers (UDP). Sin esto la overlay cae a
		# relays y la latencia se dispara.
		udp dport 9993 accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
