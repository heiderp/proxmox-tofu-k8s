# Gestionado por Ansible (rol caddy).
{
	# La CA interna no se instala en el almacén del sistema de la VM: solo la
	# necesitan los clientes, y cada uno la recibe aparte.
	skip_install_trust
	auto_https disable_redirects
}

# Certificado para la IP de la overlay, firmado por la CA interna de Caddy: sin
# DNS, sin dominio y sin Let's Encrypt. Engram exige HTTPS para mandar el token
# (`bearer token requires an HTTPS remote URL`, comprobado en el gate).
https://{{ zerotier_hub_ip }} {
	tls internal
	reverse_proxy 127.0.0.1:{{ engram_cloud_port }}
}
