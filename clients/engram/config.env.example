# Configuración del cliente del hub de engram. Copia real en
# ~/.config/engram-hub/config.env (modo 600, la crea install-client.sh).
# Formato KEY=valor, sin comillas ni variables: lo leen tanto el shell como
# systemd (EnvironmentFile), que no expande nada. @HOME@ lo sustituye el
# instalador por la ruta absoluta.

# Identidad de este cliente: nombre de su token en el servidor y sufijo de su
# llave de grants. Uno de engram_client_tokens (ansible/group_vars/engram.yml).
ENGRAM_CLIENT_ID=pc-ph

# Hub: IP del hub en la overlay ZeroTier, servida por Caddy con CA interna.
ENGRAM_CLOUD_SERVER=https://10.254.54.1
# Token gestionado de este cliente. Lo rellena install-client.sh al recogerlo.
ENGRAM_CLOUD_TOKEN=
# Exactamente "1": cualquier otro valor lo desactiva.
ENGRAM_CLOUD_AUTOSYNC=1

# CA del sistema + CA interna de Caddy, solo para el proceso engram.
SSL_CERT_FILE=@HOME@/.config/engram-hub/ca-bundle.pem

# Réplica local, autoritativa.
ENGRAM_DATA_DIR=@HOME@/.engram

# Para la LAN (recoger token y backups) y para pedir grants.
ENGRAM_HUB_LAN=192.168.1.54
ENGRAM_HUB_ZT=10.254.54.1
